{
  "name": "swapo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "bundle": "expo export --platform ios --output-dir .expo-bundle-check",
    "agents:check": "node scripts/agents/check-ownership.mjs",
    "agents:prompt": "bash scripts/agents/prompt.sh",
    "agents:status": "node scripts/agents/status.mjs",
    "content:status": "node scripts/pipeline/dashboard.mjs"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.0",
