{
  "expo": {
    "name": "swypo",
    "slug": "swapo",
    "version": "1.0.0",
    "scheme": "swapo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.swapo.ios",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "swypo nutzt die Kamera, um Wörter von einer Seite zu scannen.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "swypo nutzt die Kamera, um Wörter von einer Seite zu scannen."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-apple-authentication"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "a2fe63fd-0808-4076-b613-81ee8646a18a"
      }
    },
    "owner": "shivamsharmade"
  }
}
