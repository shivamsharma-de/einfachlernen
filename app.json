{
  "expo": {
    "name": "swapo",
    "slug": "swapo",
    "version": "1.0.0",
    "scheme": "swapo",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.swapo.ios",
      "usesAppleSignIn": true,
      "usesNonExemptEncryption": false,
      "infoPlist": {
        "NSCameraUsageDescription": "swapo nutzt die Kamera, um Wörter von einer Seite zu scannen.",
        "NSPhotoLibraryUsageDescription": "swapo nutzt deine Fotos, um Wörter von einer Seite zu scannen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "swapo nutzt die Kamera, um Wörter von einer Seite zu scannen."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-apple-authentication"
    ]
  }
}
