# Edge Function environment. Copy to .env.local (gitignored) and fill in the key.
#
#   supabase functions serve --env-file supabase/functions/.env.local
#
# The Anthropic key lives ONLY here and in the deployed project's secrets — never
# in client code, never in an EXPO_PUBLIC_ variable (PRD §5, decision D5).

ANTHROPIC_API_KEY=sk-ant-...

# Model IDs are read via Deno.env; never hard-code them in a function.
# Opus 5 is $5/$25 per MTok; the Message Batches API used by the content
# pipeline runs at 50% of that.
ANTHROPIC_MODEL_TEXT=claude-opus-5
ANTHROPIC_MODEL_VISION=claude-opus-5
